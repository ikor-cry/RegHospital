<Page x:Class="RegHospitalDesctop.RoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RoomPage">

    <StackPanel>
        <TextBlock Text="Комнаты" FontSize="20"/>


        <ScrollViewer Height="200">
            <ItemsControl x:Name="RoomsList" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>



                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="Aqua" Margin="5" MouseDown="Border_MouseDown">
                            <StackPanel Margin="5" Width="150" MouseDown="StackPanel_MouseDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" Width="70" FontSize="30"/>
                                    <TextBlock Text="{Binding Floor}" Width="50" FontSize="30"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Purpose}" Width="140"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="TextStackPanel">
            <TextBox Text="{Binding Number}" Width="150" Margin="10"/>
            <TextBox Text="{Binding Floor}" Width="150" Margin="10"/>
            <TextBox Text="{Binding Purpose}" Width="150" Margin="10"/>
        </StackPanel>
        
        <Button Content="Сохранить изменения" Click="Button_Click"/>

        <Button Content="Удалить" Click="Del_Click"/>


    </StackPanel>
</Page>
