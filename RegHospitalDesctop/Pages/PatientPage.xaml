<Page x:Class="RegHospitalDesctop.Pages.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PatientPage">

    <StackPanel>
        <TextBlock Text="Пациенты" FontSize="20"/>
        <DataGrid x:Name="tablePatient" Height="300"/>

        <Button Content="Сохранить изменнеия" Click="Button_Click"/>
    </StackPanel>
</Page>
