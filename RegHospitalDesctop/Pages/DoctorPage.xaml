<Page x:Class="RegHospitalDesctop.Pages.DoctorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DoctorPage">

    <StackPanel>
        <TextBlock Text="Доктора" FontSize="20"/>
        <DataGrid x:Name="tableDoctor" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="tableDoctor_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}"/>
                <DataGridTextColumn Header="специальность" Binding="{Binding Specialtie.Name}"/>
                <DataGridTextColumn Header="кабинет" Binding="{Binding Room.Number}"/>
            </DataGrid.Columns>
        </DataGrid>
            
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding FullName}" Height="20" Width="200" Background="Azure" Margin="10"/>
            <ComboBox  x:Name="SpecList" DisplayMemberPath="Name" SelectedValuePath="SpecialtieId" SelectedValue="{Binding SpecialtieId}" Height="18" Width="80" Margin="10"/>
            <ComboBox  x:Name="RoomsList" DisplayMemberPath="Number" SelectedValuePath="RoomId" SelectedValue="{Binding RoomId}" Height="18" Width="80" Margin="10"/>
            <TextBox Text="{Binding WorkShedule}" Height="20" Width="150" Background="Azure" Margin="10"/>

        </StackPanel>

        <Button Content="Сохранить изменения" Click="btnclick"/>
        <Button Content="Добавить" Click="Button_Click"/>
        <Button Content="Удалить" Click="ButtonDel_Click"/>
      


    </StackPanel>
        

</Page>
